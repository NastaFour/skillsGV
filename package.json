{
  "name": "skillsgv",
  "version": "2.1.1",
  "description": "Catálogo general de skills para agentes de IA (Portable 2026, pnpm)",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "test:addon": "node --test gentle-ai-dsh/test/**/*.test.mjs",
    "validate": "node 00-meta-skills/skill-validator/scripts/validate-skills.mjs",
    "validate:strict": "node 00-meta-skills/skill-validator/scripts/validate-skills.mjs --strict",
    "router": "node 00-meta-skills/skill-router/scripts/skill-router.mjs",
    "registry:sync": "node 00-meta-skills/skill-loader/scripts/skills-loader.mjs --emit-registry",
    "skills:sync": "node 00-meta-skills/skill-sync/scripts/install-skills.mjs",
    "doctor": "node 00-meta-skills/catalog-doctor/scripts/catalog-doctor.mjs"
  }
}
